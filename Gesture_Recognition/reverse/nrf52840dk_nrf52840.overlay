/* boards/nrf52840dk_nrf52840.overlay */

/* ----------- PINCTRL ----------- */
&pinctrl {
    /* I2C0：SDA=P0.26 / SCL=P0.27 */
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
                    <NRF_PSEL(TWIM_SCL, 0, 27)>;
            low-power-enable;
        };
    };

    /* UART1（UWB） */
    uart1_default: uart1_default {
        group1 { psels = <NRF_PSEL(UART_RX, 1, 1)>; bias-pull-up; };
        group2 { psels = <NRF_PSEL(UART_TX, 1, 2)>; };
    };
    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_RX, 1, 1)>,
                    <NRF_PSEL(UART_TX, 1, 2)>;
            low-power-enable;
        };
    };

    /* UART0（ECG）：TX=P0.06，RX=P1.08 */
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 1, 8)>;
            bias-pull-up;
        };

    };
    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>,
                    <NRF_PSEL(UART_RX, 1, 8)>;
            low-power-enable;
        };
    };
};

/* ----------- 外设节点 ----------- */

/* 打开 UART0（ECG），57600/8N1；绑定到 P0.06 / P1.08 */
&uart0 {
    status        = "okay";
    current-speed = <57600>;
    pinctrl-0     = <&uart0_default>;
    pinctrl-1     = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
        /* 删除旧式引脚属性，避免和 pinctrl 混在一起显示 */
    /delete-property/ rx-pin;
    /delete-property/ tx-pin;
    /delete-property/ rts-pin;
    /delete-property/ cts-pin;
};

/* UART1（UWB）保持不变 */
&uart1 {
    status        = "okay";
    current-speed = <115200>;
    pinctrl-0     = <&uart1_default>;
    pinctrl-1     = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};

/* 依然禁用 SPI1 */
&spi1 {
    status = "disabled";
};

/* I2C0 保持开启 */
&i2c0 {
    compatible      = "nordic,nrf-twim";
    status          = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0       = <&i2c0_default>;
    pinctrl-1       = <&i2c0_sleep>;
    pinctrl-names   = "default", "sleep";

    jy901b@50 {
        compatible = "gpio-keys";   /* 用一个有 binding 的兼容，避免部分环境对“void”告警 */
        reg = <0x50>;
        status = "okay";
        /* 不实际使用中断，仅占位 */
        button: button {
            gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
            label = "dummy";
        };
    };
};

/* 1) 禁用 QSPI，释放 P0.17..P0.23 */
&qspi {
    status = "disabled";
};

/* 2) 重新声明 gpio-reserved-ranges，不再预留 17..23 */
&gpio0 {
    /* 保留原板的 0..1, 6, 8..10 等，但去掉 17..23 */
    gpio-reserved-ranges = <0 2>, <6 1>, <8 3>;
};

/* 3) ECG RESET（低有效，P0.17） */
 / {
    ecg_reset: ecg_reset {
        compatible = "gpio-keys";
        ecg_rst: ecg_rst {
            gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;  /* P0.17 → RESET */
            label = "ECG_RST";
        };
    };
};

/* 4) 关掉 USB（可留可去） */
&usbd {
    status = "disabled";
};
/delete-node/ &{/pin-controller/uart0_default/group2/};
