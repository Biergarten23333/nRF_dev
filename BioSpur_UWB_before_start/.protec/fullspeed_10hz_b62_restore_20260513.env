# BioSpur UWB emergency restore / full-speed Tag baseline.
#
# Created: 2026-05-13
# Purpose:
#   Record the recovered 5/4-era Tag/Master_Tag line that restored full-speed
#   10 Hz/tag output on the old3 Tags after the 2026-05-12 outdoor disruption.
#
# Scope:
#   This is a Tag / Master_Tag runtime baseline only.
#   It does not authorize Anchor or Master_Anchor image changes.

export BIOSPUR_FULLSPEED_RESTORE_ACTIVE="1"
export BIOSPUR_FULLSPEED_RESTORE_NAME="restore_20260504_b62_otaprep_silent_10hz_old3_20260513"
export BIOSPUR_FULLSPEED_RESTORE_DATE="2026-05-13"

# Protected master roles.
export BIOSPUR_MASTER_ANCHOR_SNR="960148546"
export BIOSPUR_MASTER_ANCHOR_ROLE="Master_Anchor"
export BIOSPUR_MASTER_TAG_SNR="1050070698"
export BIOSPUR_MASTER_TAG_ROLE="Master_Tag"

# Do not touch Anchor / Master_Anchor for this restore point.
export BIOSPUR_FULLSPEED_RESTORE_ANCHOR_CHANGES_ALLOWED="0"
export BIOSPUR_FULLSPEED_RESTORE_MASTER_ANCHOR_CHANGES_ALLOWED="0"
export BIOSPUR_FULLSPEED_RESTORE_KEEP_ANCHOR_FREEZE_MANIFEST=".protec/anchor_master_freeze.env"

# Restored 5/4-era Tag payload and Master_Tag carrier.
export BIOSPUR_FULLSPEED_TAG_BUILD="SS-TWR/alt-SS-TWR/broadcast/build-alt-bcast-b62-otaprep-silent-tag-g1200-r1000-rms0"
export BIOSPUR_FULLSPEED_TAG_MARKER="alt-bcast-b62-otaprep-silent-g1200-r1000"
export BIOSPUR_FULLSPEED_MASTER_TAG_BUILD="SS-TWR/alt-SS-TWR/broadcast/build-master-control-b120-m1-master-tag-lfrc-alt-bcast-b62-otaprep-silent-carrier"
export BIOSPUR_FULLSPEED_MASTER_TAG_EMBEDDED_PAYLOAD_KIND="tag"
export BIOSPUR_FULLSPEED_MASTER_TAG_LFRC_REQUIRED="1"
export BIOSPUR_FULLSPEED_MASTER_TAG_USB_MANUFACTURER="Master_Tag"
export BIOSPUR_FULLSPEED_MASTER_TAG_USB_PRODUCT="BioSpur_BLE_Control"

# Archived source of the restored builds.
export BIOSPUR_FULLSPEED_ARCHIVE_ROOT="/home/zekaixiao/Documents/nRF_dev/BioSpur_UWB_before_start-reserve/build_archive_20260511_224100/repo"
export BIOSPUR_FULLSPEED_ARCHIVED_TAG_BUILD="$BIOSPUR_FULLSPEED_ARCHIVE_ROOT/SS-TWR/alt-SS-TWR/broadcast/build-alt-bcast-b62-otaprep-silent-tag-g1200-r1000-rms0"
export BIOSPUR_FULLSPEED_ARCHIVED_MASTER_TAG_BUILD="$BIOSPUR_FULLSPEED_ARCHIVE_ROOT/SS-TWR/alt-SS-TWR/broadcast/build-master-control-b120-m1-master-tag-lfrc-alt-bcast-b62-otaprep-silent-carrier"

# Runtime TDMA parameters observed after restore.
# Note: the scheduler reports actual_hz=8.33 because this 40/24 line uses
# two TDMA slots per Tag, but the emitted TR sweep stream is full 10 Hz/tag.
export BIOSPUR_FULLSPEED_TDMA_PERIOD_MS="40"
export BIOSPUR_FULLSPEED_TDMA_ACTIVE_MS="24"
export BIOSPUR_FULLSPEED_TDMA_ACTIVE_US="0"
export BIOSPUR_FULLSPEED_TDMA_TARGET_HZ="10"
export BIOSPUR_FULLSPEED_GUARD_US="1200"
export BIOSPUR_FULLSPEED_RESP_SPACING_US="1000"

# OTA record for old3 Tags.
export BIOSPUR_FULLSPEED_OTA_OLD3_LOG="autopos_pipeline/outdoor_20260512/tag_captures/ota_old3_b62_10x10hz_restore_20260513_013311"
export BIOSPUR_FULLSPEED_OTA_OLD3_TARGETS="BSF66F,BS2DCE,BSDC91"
export BIOSPUR_FULLSPEED_OTA_OLD3_RESULT="ota_success_observed_for_all_three; post-version-readback-not-confirmed"

# Full-speed validation record.
export BIOSPUR_FULLSPEED_STRESS_LOG="autopos_pipeline/outdoor_20260512/tag_captures/stress_old3_restore_5_4_b62_10hz_300s_20260513_030054_20260513_030054"
export BIOSPUR_FULLSPEED_STRESS_DURATION_S="300"
export BIOSPUR_FULLSPEED_STRESS_TARGETS="BSF66F,BS2DCE,BSDC91"
export BIOSPUR_FULLSPEED_STRESS_TR_ALL="72016"
export BIOSPUR_FULLSPEED_STRESS_EXPECTED_ROWS="72000"
export BIOSPUR_FULLSPEED_STRESS_ROW_RATE="240.05"
export BIOSPUR_FULLSPEED_STRESS_SWEEPS_TOTAL="9002"
export BIOSPUR_FULLSPEED_STRESS_EXPECTED_SWEEPS="9000"
export BIOSPUR_FULLSPEED_STRESS_PASS="1"

# Per-tag proof from the 300 s validation.
export BIOSPUR_FULLSPEED_BSF66F_ROWS="24008"
export BIOSPUR_FULLSPEED_BSF66F_SWEEPS="3001"
export BIOSPUR_FULLSPEED_BSF66F_HZ="10.003"
export BIOSPUR_FULLSPEED_BSF66F_SW8_RATIO="0.736421"
export BIOSPUR_FULLSPEED_BSF66F_SW7_RATIO="0.996335"
export BIOSPUR_FULLSPEED_BSF66F_ANCHORS_SEEN="0,1,2,3,4,5,6,7"

export BIOSPUR_FULLSPEED_BS2DCE_ROWS="24000"
export BIOSPUR_FULLSPEED_BS2DCE_SWEEPS="3000"
export BIOSPUR_FULLSPEED_BS2DCE_HZ="10.000"
export BIOSPUR_FULLSPEED_BS2DCE_SW8_RATIO="0.811000"
export BIOSPUR_FULLSPEED_BS2DCE_SW7_RATIO="0.997667"
export BIOSPUR_FULLSPEED_BS2DCE_ANCHORS_SEEN="0,1,2,3,4,5,6,7"

export BIOSPUR_FULLSPEED_BSDC91_ROWS="24008"
export BIOSPUR_FULLSPEED_BSDC91_SWEEPS="3001"
export BIOSPUR_FULLSPEED_BSDC91_HZ="10.003"
export BIOSPUR_FULLSPEED_BSDC91_SW8_RATIO="0.000000"
export BIOSPUR_FULLSPEED_BSDC91_SW7_RATIO="0.000000"
export BIOSPUR_FULLSPEED_BSDC91_ANCHORS_SEEN="0,1,2,3,4,5,6"

# Known open issue:
#   Full-speed output is restored, but BSDC91 did not see Anchor 7/H in the
#   300 s validation. Treat this as a UWB visibility / Anchor H quality issue,
#   not as a TDMA 10 Hz throughput failure.
export BIOSPUR_FULLSPEED_KNOWN_ISSUE="BSDC91_missing_anchor_7_H_in_300s_validation"

