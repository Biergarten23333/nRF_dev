# BioSpur B120 local port map for dual-master validation.
export BIOSPUR_ANCHOR_SNR=960148546
export BIOSPUR_ANCHOR_PORT=/dev/serial/by-id/usb-Master_Anchor_BioSpur_BLE_Control_87EA2F4A526C5A02-if00
export BIOSPUR_TAG_SNR=1050070698
export BIOSPUR_TAG_PORT=/dev/serial/by-id/usb-Master_Tag_BioSpur_BLE_Control_6918E0384172A49F-if00

# Backward-compatible aliases.
export BIOSPUR_BASELINE_SNR="$BIOSPUR_ANCHOR_SNR"
export BIOSPUR_BASELINE_PORT="$BIOSPUR_ANCHOR_PORT"
export BIOSPUR_1_SNR="$BIOSPUR_TAG_SNR"
export BIOSPUR_1_PORT="$BIOSPUR_TAG_PORT"
