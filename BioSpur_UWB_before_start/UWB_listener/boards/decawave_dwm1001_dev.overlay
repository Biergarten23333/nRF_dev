/*
 * Listener-only hardware overlay.
 *
 * J10 wiring used by this app:
 * - J10 pin 19 / SPIS_MOSI / nRF P0.06 -> 74HC595 SER
 * - J10 pin 23 / SPIS_CLK  / nRF P0.04 -> 74HC595 SRCLK
 * - J10 pin 24 / SPIS_CSn  / nRF P0.03 -> 74HC595 RCLK
 * - J10 pin 15 / READY     / nRF P0.26 -> button to GND
 *
 * The pins above are controlled as plain GPIOs here, so disable the board's
 * spi1 node that normally owns P0.03/P0.04/P0.06/P0.07.
 */
&spi1 {
	status = "disabled";
};

/*
 * Console UART at 460800 to match the co-located CIR listener fleet and the host
 * capture convention. MODE_SCAN streams a full 4064-byte CIR (8128 hex chars) per
 * captured cycle; 460800 is the reliable ceiling over the J-Link OB VCOM (1 Mbaud
 * drops bytes). MODE_GEIGER only emits low-rate text, so the higher baud is
 * transparent to it. Host must open the port at the same baud.
 */
&uart0 {
	current-speed = <460800>;
};
