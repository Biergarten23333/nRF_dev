#!/usr/bin/env bash
set -euo pipefail

NRFUTIL_DEVICE_BIN="${NRFUTIL_DEVICE_BIN:-/home/zekaixiao/.vscode/extensions/nordic-semiconductor.nrf-connect-2026.3.1484-linux-x64/platform/nrfutil/bin/nrfutil-device}"

if [[ ! -x "$NRFUTIL_DEVICE_BIN" ]]; then
  echo "nrfutil-device not found: $NRFUTIL_DEVICE_BIN" >&2
  exit 127
fi

args=()
for arg in "$@"; do
  if [[ "$arg" == "device" ]]; then
    continue
  fi
  args+=("$arg")
done

exec "$NRFUTIL_DEVICE_BIN" "${args[@]}"
