/ {
    aliases { spi3 = &spi3; };
};

/* 启用 USB 设备控制器 */
&usbd {
    status = "okay";

    /* 新建一个 CDC ACM 节点，label 一定要给，这个就是设备名 */
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
        status = "okay";
    };
};

/* ✅ 修正：pwm0 用 pinctrl 方式绑定到 P1.02（PWM0_CH0） */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/* UART0 是否开启随你，这里保留 */
&uart0 {
    current-speed = <460800>;
    status = "okay";
};

/* 你的 SPI3 + pinctrl（保持不变） */
&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    /* 如需驱动自动控片选，取消下面注释，并在 C 里配置 spi_cfg.cs */
    // cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
};

/* pinctrl 区域：保留你原来的 SPI3 分组，并新增 PWM0 分组 */
&pinctrl {
    /* ===== SPI3（保持不变） ===== */
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };

    /* ===== PWM0: 将 PWM0_CH0 绑定到 P1.02 ===== */
    pwm0_default: pwm0_default {
        group0 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 2)>;   /* P1.02 */
        };
    };
    pwm0_sleep: pwm0_sleep {
        group0 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 2)>;
            low-power-enable;
        };
    };
};
