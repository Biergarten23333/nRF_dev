# Zephyr / west build output. These are the only permitted build roots, so a
# misplaced build directory anywhere else remains visible in git status.
B306_Part/builds/*
!B306_Part/builds/README.md
UWB_Part/builds/*
!UWB_Part/builds/README.md
zephyr/
.west/
*.source

# Runtime logs and captures
B306_Part/logs/
*.log
*.jsonl
*.parquet
*.pcap
*.pcapng
*.raw

# Host-language caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Editor and OS noise
.DS_Store
*~
*.swp

# The rollback baseline is an immutable archive and must be tracked in full,
# even if a future archive contains a normally ignored capture/build suffix.
!UWB_Part/2026-07-15-FREEZE/
!UWB_Part/2026-07-15-FREEZE/**
