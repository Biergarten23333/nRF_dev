  "properties": {
    "schema": {"const": "canonical-human-state-v0.1"},
    "active_modality": {"const": "IMU_ONLY"},
    "world_absolute_state": {"const": "UNAVAILABLE"},
    "feet": {"const": "UNAVAILABLE"},
