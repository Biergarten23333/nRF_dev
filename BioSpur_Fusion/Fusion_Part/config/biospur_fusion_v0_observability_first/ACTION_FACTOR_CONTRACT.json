  "fail_closed": {
    "missing_complete_episode": "CALIBRATION_EPISODE_INCOMPLETE",
    "missing_noncollinear_excitation": "FAIL_ACTION_EXCITATION",
    "measurement_profiled_rank_deficient": "FAIL_OBSERVABILITY",
    "product_distinct_sign_or_handedness_tie": "FAIL_AMBIGUOUS_SIGN_OR_HANDEDNESS",
