  "synthetic_acceptance": {
    "maximum_heading_truth_error_deg": 5.0,
    "maximum_mount_rotation_truth_error_deg": 20.0,
    "maximum_axial_offset_truth_error_m": 0.02,
    "require_all_qmt_qualifications": true,
    "degenerate_case_must_reject": true
