    "chest_to_acromion_bounds_m": [0.13, 0.16],
    "pelvis_imu_to_chest_imu_m": 0.28,
    "pelvis_imu_to_chest_imu_bounds_m": [0.26, 0.30],
    "pelvis_center_to_hip_center_vertical_offset_m": 0.06,
    "sensor_axial_offset_nominal_m": [0.05, 0.04, 0.05, 0.04, 0.08, 0.08, 0.08, 0.08],
    "sensor_axial_offset_lower_m": [0.015, 0.015, 0.015, 0.015, 0.03, 0.03, 0.03, 0.03],
    "sensor_axial_offset_upper_m": [0.11, 0.10, 0.11, 0.10, 0.16, 0.16, 0.16, 0.16],
    "internal_hip_center_spacing_status": "UNMEASURED_NOT_DERIVED_FROM_SURFACE_BREADTHS",
    "internal_hip_center_spacing_nominal_m": 0.22,
    "internal_hip_center_spacing_sensitivity_m": [0.18, 0.22, 0.26]
  },
  "hard_feasibility": {
    "minimum_left_right_joint_separation_m": 0.02,
    "maximum_standing_knee_front_back_split_m": 0.08,
    "minimum_standing_proximal_distal_vertical_drop_m": 0.08,
    "maximum_segment_length_error_m": 0.000001,
    "minimum_rotation_determinant": 0.999,
    "rom_tolerance_deg": 10.0,
    "physical_gate_is_optimizer_loss": false
  },
  "acceptance": {
    "gauge_reduced_heading_rank": 9,
    "maximum_heading_posterior_sigma_deg": 15.0,
    "maximum_multistart_branch_spread_deg": 15.0,
    "maximum_functional_mount_branch_spread_deg": 25.0,
    "maximum_progressive_batch_heading_difference_deg": 3.0,
    "maximum_progressive_batch_mount_difference_deg": 5.0,
    "maximum_held_out_joint_center_nrmse": 2.5,
    "minimum_held_out_improvement_over_uncalibrated_fraction": 0.15,
    "initial_still_may_be_ready": false,
    "all_hard_physical_gates": true,
    "independent_visual_gate": true
