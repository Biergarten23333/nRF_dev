// G3 FULL-RAM DUMP -- the exact sequence used on a wedged board.
//
// halt -> registers -> savebin all 256 KiB of RAM -> go. The whole of
// sram_primary (0x20000000..0x20040000) is taken rather than just .noinit,
// because on a wedged board there is one chance and thread stacks, the four
// v45 channel structs, the trajectory ring and the corpse all live in it.
//
// No reset. The `go` at the end matters: leaving the core halted would stop
// the watchdog being fed with no debugger attached to un-halt it.
si 1
speed 4000
device NRF52840_XXAA
connect
halt
regs
savebin RAMDUMP_PATH, 0x20000000, 0x40000
go
exit
