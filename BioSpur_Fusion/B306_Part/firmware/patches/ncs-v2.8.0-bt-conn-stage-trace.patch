+#ifdef BSF_BT_STAGE_TRACE_PRESENT
+/*
+ * ---------------------------------------------------------------------------
+ * v43 corpse capture (batch v43_selfcapture_20260807).
+ *
+ * Lives here, and not in the application, because every field below is inside
+ * `struct bt_conn`, which is private to the host (conn_internal.h). Field names
+ * and semantics are read against THIS tree -- NCS v2.8.0 / Zephyr v3.7.99-ncs1
+ * -- not against current Zephyr main.
+ *
+ * Called from the monitor thread after it has decided the BT RX workqueue is
+ * wedged. It is a pure reader: it takes no lock, allocates nothing, and calls
+ * nothing that can block, because the thread it is inspecting is stuck and may
+ * be holding host state. A slightly inconsistent snapshot is acceptable and
+ * expected; a monitor that deadlocks against the wedge it is recording is not.
+ */
+static uint16_t bsf_slist_len(sys_slist_t *list)
+{
+	sys_snode_t *node;
+	uint16_t n = 0u;
+
+	/* Bounded: a corrupt list must not hang the monitor. */
+	SYS_SLIST_FOR_EACH_NODE(list, node) {
+		if (++n >= 1024u) {
+			break;
+		}
+	}
+	return n;
+}
+
+void bsf_bt_capture_conn(struct bsf_bt_corpse_conn *out)
+{
+	struct bt_conn *conn = NULL;
+
+	if (out == NULL) {
+		return;
+	}
+	memset(out, 0, sizeof(*out));
+
+	/*
+	 * Pick the connection object directly out of acl_conns[] rather than
+	 * through bt_conn_lookup_*(), which takes a reference and can alter
+	 * host state. With CONFIG_BT_MAX_CONN=1 this is a single slot.
+	 */
+	for (size_t i = 0; i < ARRAY_SIZE(acl_conns); i++) {
+		if (acl_conns[i].state != BT_CONN_DISCONNECTED) {
+			conn = &acl_conns[i];
+			break;
+		}
+	}
+	if (conn == NULL && ARRAY_SIZE(acl_conns) > 0) {
+		/* Record slot 0 anyway: "disconnected" is itself evidence. */
+		conn = &acl_conns[0];
+	}
+	if (conn == NULL) {
+		return;
+	}
+
+	out->conn_addr = (uint32_t)(uintptr_t)conn;
+	out->handle = conn->handle;
+	out->type = (uint8_t)conn->type;
+	out->role = conn->role;
+	out->err = conn->err;
+	out->state = (uint8_t)conn->state;
+	out->rx_ptr = (uint32_t)(uintptr_t)conn->rx;
+	out->rx_len = conn->rx_len;
+	out->tx_pending = bsf_slist_len(&conn->tx_pending);
+	out->tx_complete = bsf_slist_len(&conn->tx_complete);
+#if defined(CONFIG_BT_CONN_TX)
+	out->tx_complete_busy = k_work_busy_get(&conn->tx_complete_work);
+#else
+	out->tx_complete_busy = -1;
+#endif
+	out->deferred_busy = k_work_delayable_busy_get(&conn->deferred_work);
+	out->pkts_avail = k_sem_count_get(bt_conn_get_pkts(conn));
+	out->valid = 1u;
+}
+#endif /* BSF_BT_STAGE_TRACE_PRESENT */
