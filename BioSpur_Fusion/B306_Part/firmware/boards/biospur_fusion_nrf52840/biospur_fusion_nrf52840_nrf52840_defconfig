# BioSpur Fusion NINA-B306-01B board configuration

# SPDX-License-Identifier: Apache-2.0

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y

# NINA-B306-01B has no 32.768 kHz crystal. NCS v2.8 names the calibration
# option CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y
